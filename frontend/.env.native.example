# Copy to frontend/.env.native.local (gitignored). Loaded ONLY by `vite build --mode native`
# (npm run ios:sync / npm run android:sync), so plain web dev keeps using the Vite /api proxy.
#
# Absolute URL of the backend container as seen FROM THE DEVICE:
#   iOS Simulator:     http://localhost:3001   (simulator shares the Mac's network)
#   Android Emulator:  http://10.0.2.2:3001    (10.0.2.2 is the emulator's alias for the host Mac)
#   Physical phone:    http://<LAN-IP-of-the-container-host>:3001   (ipconfig getifaddr en0)
# On Android, plain http:// is only allowed to localhost, 10.0.2.2 and the host named here
# (scripts/android-network-config.mjs bakes it into network_security_config.xml at sync time).
VITE_API_URL=http://192.168.1.20:3001
# Hosted backend instead (AWS App Runner). Must match API_KEY on the server.
# VITE_API_URL=https://xxxxxxxxxx.us-east-1.awsapprunner.com
# VITE_API_KEY=paste-the-same-secret-here
