# Copy to frontend/.env.ios.local (gitignored). Loaded ONLY by `vite build --mode ios`
# (npm run ios:sync), so plain web dev keeps using the Vite /api proxy.
#
# Absolute URL of the backend container as seen FROM THE PHONE:
#   iOS Simulator:   http://localhost:3001   (simulator shares the Mac's network)
#   Physical iPhone: http://<LAN-IP-of-the-container-host>:3001   (ipconfig getifaddr en0)
VITE_API_URL=http://192.168.1.20:3001
