# Copy to backend/.env for local runs, or set these in docker-compose.yml.
PORT=3001
HOST=0.0.0.0
# Where scraped sales/store lookups are cached (12h sales TTL, 7d stores TTL).
CACHE_DIR=./sales_cache
# ZIP used when a request omits ?zip=
DEFAULT_ZIP=64683
# Comma-separated CORS allowlist. Leave unset to allow any origin (needed for the
# Capacitor iOS shell, whose origin is capacitor://localhost).
# CORS_ORIGIN=capacitor://localhost,http://localhost:5173
# Shared secret for public deployments. When set, clients must send X-Api-Key.
# API_KEY=
# Reported by GET /api/health
APP_VERSION=dev
